# cp .env.example .env 후 사용한다. .env는 커밋하지 않는다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_pw

# infra/postgres/init.sh가 최초 빈 DB에 이 값으로 서비스 계정을 만든다.
# 기존 볼륨의 계정 비밀번호는 이 파일을 바꿔도 자동 갱신되지 않는다.
USER_DB_PASSWORD=user_local_pw
PERFORMANCE_DB_PASSWORD=performance_local_pw
RESERVATION_DB_PASSWORD=reservation_local_pw
PAYMENT_DB_PASSWORD=payment_local_pw
# 테스트용 fake PG(backend/fake-pg). 기존 DB 볼륨에는 이 계정이 없으므로 처음 한 번 script/run.sh --reset이 필요하다.
FAKE_PG_DB_PASSWORD=fake_pg_local_pw

# user-service가 기동할 때 이 계정이 없으면 MASTER로 만든다. 비워 두면 만들지 않는다.
# 로그인 ID는 이메일이다. 로컬 전용 값이다.
MASTER_EMAIL=master@ticket.com
MASTER_PASSWORD=Master!2026

# HS256 서명 키. 32바이트 이상
JWT_SECRET=local-only-jwt-secret-key-change-me-0123456789

# Grafana admin 계정 비밀번호(아이디는 admin). 로컬 전용 값이다.
# Grafana 볼륨이 이미 있으면 이 값을 바꿔도 기존 비밀번호는 바뀌지 않는다.
GRAFANA_ADMIN_PASSWORD=grafana_local_pw

# 다른 실행 환경(예: logistics-management)과 병행할 때 호스트 포트와 Compose 프로젝트 이름을 다르게 설정한다.
# 컨테이너 사이 통신 포트는 바뀌지 않는다. IDE로 서비스를 띄우면 실행 설정의 DB_PORT·REDIS_PORT도 아래 값과 같게 둔다.
POSTGRES_PORT=5432
REDIS_PORT=6379
CONFIG_SERVER_PORT=8888
EUREKA_PORT=8761
GATEWAY_PORT=8080
KAFKA_PORT=9092
KAFKA_UI_PORT=8989
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
ALERT_MOCK_PORT=9094
FAKE_PG_PORT=8090
# COMPOSE_PROJECT_NAME=ticket
# 앞단 Docker 네트워크 대역. 기본 10.220.10.0/24. PC의 다른 네트워크(VPN 등)와 겹칠 때만 둘을 함께 바꾼다.
# TICKET_NET_SUBNET=10.220.10.0/24
# TICKET_NET_PREFIX=10.220.10.

# Alertmanager가 보낼 Slack incoming webhook URL을 담은 파일 경로. URL 자체를 여기에 쓰지 않는다.
# 실제 Slack에 보낼 때만 infra/alertmanager/secrets/에 URL 한 줄짜리 파일을 만들고 지정한다(Git 비추적).
# 지정하지 않으면 모의 수신기(alert-mock)로 보낸다. ALERT_MOCK_MODE: ok, 429, 500, slow
# SLACK_WEBHOOK_URL_FILE=./infra/alertmanager/secrets/slack_webhook_url
# ALERT_MOCK_MODE=ok
