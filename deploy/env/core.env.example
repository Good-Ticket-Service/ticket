# vm-core의 /opt/ticket/.env 틀. 이 서버에 필요한 값만 있다.
# 실제 값은 서버의 /opt/ticket/.env 한 곳에만 둔다(소유자 root, 권한 600). 저장소·이슈·채팅에 쓰지 않는다.
# DB 관리자 비밀번호와 JWT·입장 토큰 키는 여기에 넣지 않는다. 이 서버가 뚫려도 토큰을 위조하거나 다른 서비스 DB에 들어갈 수 없게 한다.

# 프라이빗 IP. EDGE_IP는 config-server·Eureka 주소, CORE_IP는 Eureka에 등록할 이 서버 주소, DATA_IP는 DB·Redis·Kafka·fake-pg 주소다.
EDGE_IP=
CORE_IP=
DATA_IP=

# 이미지 저장소와 태그. 태그는 deploy/build-push.sh가 출력하는 커밋 SHA다.
ECR_REGISTRY=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=

# 이 서버에서 뜨는 서비스(reservation·payment)의 DB 비밀번호. vm-data .env의 같은 이름 값과 같아야 한다.
RESERVATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
