# vm-edge의 /opt/ticket/.env 틀. 이 서버에 필요한 값만 있다.
# 실제 값은 서버의 /opt/ticket/.env 한 곳에만 둔다(소유자 root, 권한 600). 저장소·이슈·채팅에 쓰지 않는다.
# 비밀번호와 키는 로컬 값을 쓰지 않고 새로 만든다. 예: openssl rand -base64 48

# 프라이빗 IP. EDGE_IP는 Eureka에 등록할 이 서버 주소, DATA_IP는 DB·Redis·Kafka 주소다.
EDGE_IP=
DATA_IP=
# DNS A 레코드가 vm-edge의 Elastic IP를 가리켜야 Caddy가 인증서를 받는다
DOMAIN=

# 이미지 저장소와 태그. 태그는 deploy/build-push.sh가 출력하는 커밋 SHA다.
ECR_REGISTRY=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=

# 이 서버에서 뜨는 서비스(user·performance)의 DB 비밀번호. vm-data .env의 같은 이름 값과 같아야 한다.
USER_DB_PASSWORD=
PERFORMANCE_DB_PASSWORD=

# HS256 서명 키. 각각 32바이트 이상이고 서로 달라야 한다.
# JWT_SECRET은 gateway·user, QUEUE_TOKEN_SECRET은 gateway·waiting-room이 쓴다. 둘 다 이 서버에만 둔다.
JWT_SECRET=
QUEUE_TOKEN_SECRET=

# user-service가 기동할 때 이 계정이 없으면 MASTER로 만든다. 비워 두면 만들지 않는다.
MASTER_EMAIL=
MASTER_PASSWORD=

# 프론트 빌드 결과 위치. 기본은 /opt/ticket/frontend/dist
# FRONTEND_DIST=/opt/ticket/frontend/dist
