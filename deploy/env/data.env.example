# vm-data의 /opt/ticket/.env 틀. 이 서버에 필요한 값만 있다.
# 실제 값은 서버의 /opt/ticket/.env 한 곳에만 둔다(소유자 root, 권한 600). 저장소·이슈·채팅에 쓰지 않는다.
# 비밀번호는 로컬 값(…_local_pw)을 쓰지 않고 새로 만든다. 예: openssl rand -base64 32

# 프라이빗 IP. DATA_IP는 Kafka가 다른 서버에 알려 줄 주소다. Prometheus는 세 IP로 Eureka와 서버별 node-exporter를 찾는다.
DATA_IP=
EDGE_IP=
CORE_IP=

# fake-pg 이미지. 태그는 deploy/build-push.sh가 출력하는 커밋 SHA다.
ECR_REGISTRY=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=

# PostgreSQL. 빈 볼륨으로 처음 띄울 때 이 값으로 서비스 계정을 만든다. 그 뒤에는 바꿔도 DB 안의 비밀번호는 바뀌지 않는다.
# 서비스 계정 비밀번호는 그 서비스가 뜨는 서버(vm-edge·vm-core)의 .env에도 같은 값으로 넣는다.
# POSTGRES_PASSWORD(관리자)는 이 서버에만 둔다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
USER_DB_PASSWORD=
PERFORMANCE_DB_PASSWORD=
RESERVATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
FAKE_PG_DB_PASSWORD=

# Grafana admin 비밀번호. 볼륨이 생긴 뒤에는 바꿔도 반영되지 않는다.
GRAFANA_ADMIN_PASSWORD=

# 실제 Slack으로 경보를 보낼 때만 URL 한 줄짜리 파일 경로를 적는다. 파일은 저장소 밖(/opt/ticket/secrets/)에 둔다.
# 비워 두면 모의 수신기(alert-mock)로 보낸다.
# SLACK_WEBHOOK_URL_FILE=/opt/ticket/secrets/slack_webhook_url
