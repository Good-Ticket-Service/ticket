        "h": 1
      }
    },
    {
      "id": 13,
      "title": "Hikari active · idle · pending · max",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"payment-service\", instance=~\"$instance\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{application=\"payment-service\", instance=~\"$instance\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{application=\"payment-service\", instance=~\"$instance\"})",
          "legendFormat": "pending(대기)"
        },
        {
          "refId": "D",
          "expr": "sum(hikaricp_connections_max{application=\"payment-service\", instance=~\"$instance\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
