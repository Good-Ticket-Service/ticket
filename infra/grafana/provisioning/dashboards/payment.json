    },
    {
      "id": 27,
      "title": "실제 PG HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 7
      },
      "targets": [
