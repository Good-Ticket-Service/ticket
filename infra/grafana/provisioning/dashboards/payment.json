      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(task)(payment_job_running{application=\"$application\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "title": "마지막 정상 잡 실행 이후 경과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time()-payment_job_last_success_timestamp_seconds{application=\"$application\"}) and on(instance,task) (payment_job_enabled{application=\"$application\"} == 1)",
          "legendFormat": "{{instance}} {{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "0건 실행도 정상이다. PG Unknown을 저장한 실행은 잡 정상이며 PG 장애는 별도 패널로 확인한다."
    },
    {
      "id": 21,
      "title": "잡 실행 결과 / 초",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
