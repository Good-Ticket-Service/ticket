          "legendFormat": "{{__name__}} {{comparison_phase}} {{cohort}} {{application}} {{service}} {{uri}} {{topic}} {{wait_event}} {{kind}} {{source}} {{name}} {{state}}"
        }
      ],
      "fieldConfig": {
