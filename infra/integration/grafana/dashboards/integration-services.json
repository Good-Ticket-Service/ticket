{
  "uid": "integration-services",
  "title": "통합시험 02 · 서비스 병목",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "integration"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "전체 현황",
      "url": "/d/integration-overview",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "서비스 병목",
      "url": "/d/integration-services",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "호스트·컨테이너",
      "url": "/d/integration-infra",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "DB·Redis·Kafka",
      "url": "/d/integration-data",
      "type": "link",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "test_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_http_reqs_total, test_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "comparison_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_probe_started_total, comparison_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "시험 단계",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": false
      }
    ]
  },
