{{/*
  payment(결제·환불·PG·정산) 경보 Slack 메시지. 경보 규칙의 주석 summary(제목)·category(종류)·detail(내용)·action(조치)과
  분류 라벨만 쓴다. 문장 대신 짧은 명사형으로 쓴다.
  거래·회원·판매자 ID, PG 키, 오류 원문은 경보에 없으므로 여기서도 넣지 않는다. 개별 건은 운영 조회에서 찾는다.
  한 그룹에 경보가 많아도 메시지가 길어지지 않게 앞의 10건만 보여 준다.

  예)
    [경보 1건] 정산 · 지급 (local)
    *[CRITICAL] 지급 응답 불일치*
    종류: 정산 · 지급
    내용: 조회 전용 지급 1건
    조치: 운영 조회 verificationReason과 지급대행 기록 대조 (재요청 금지)
*/}}

{{ define "payment.slack.title" -}}
{{ if eq .Status "firing" }}[경보 {{ .Alerts.Firing | len }}건]{{ else }}[해제]{{ end }} {{ with .CommonAnnotations.category }}{{ . }}{{ else }}{{ .CommonLabels.alertname }}{{ end }} ({{ .CommonLabels.environment }})
{{- end }}

{{ define "payment.slack.color" -}}
{{ if eq .Status "resolved" }}good{{ else if eq .CommonLabels.severity "critical" }}danger{{ else }}warning{{ end }}
{{- end }}

{{ define "payment.slack.alert" -}}
*[{{ .Labels.severity | toUpper }}] {{ .Annotations.summary }}*
{{ with .Annotations.category }}종류: {{ . }}
{{ end }}{{ with .Annotations.detail }}내용: {{ . }}
{{ end }}{{ with .Annotations.action }}조치: {{ . }}
{{ end }}
{{- end }}

{{ define "payment.slack.text" -}}
{{ if .Alerts.Firing -}}
{{ range $i, $a := .Alerts.Firing }}{{ if lt $i 10 }}{{ template "payment.slack.alert" $a }}
{{ end }}{{ end -}}
{{ if gt (len .Alerts.Firing) 10 }}외 {{ len .Alerts.Firing }}건 중 10건만 표시 (나머지는 대시보드)
{{ end -}}
{{ end -}}
{{ if .Alerts.Resolved -}}
*[해제] {{ len .Alerts.Resolved }}건*
{{ range $i, $a := .Alerts.Resolved }}{{ if lt $i 10 }}• {{ $a.Annotations.summary }}
{{ end }}{{ end -}}
참고: 위험 조건 해소. 실제 입금·전체 대사 완료와 무관
{{ end -}}
대시보드: http://localhost:3000/d/payment-operations
{{- end }}
