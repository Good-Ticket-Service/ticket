{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose build *)",
      "Bash(script/run.sh *)",
      "Bash(script/smoke.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(script/run.sh --reset *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)"
    ]
  }
}
